---
import type { CollectionEntry } from 'astro:content';

const { item } = Astro.props as { item: CollectionEntry<'videogames'> };
const game = item.data;

const completionColors: Record<string, string> = {
  'wishlist': 'bg-gray-300 text-gray-700',
  'started': 'bg-blue-300 text-blue-800',
  'played': 'bg-yellow-300 text-yellow-800',
  'completed': 'bg-green-300 text-green-800',
  '100%': 'bg-amber-400 text-amber-900',
};

const completionKey = game.completion?.toLowerCase() ?? '';
const completionClass = completionColors[completionKey] ?? 'bg-gray-300 text-gray-700';
---

<div class="skill-item relative px-4 py-6 group">
    
    <!-- Item content -->
    <div class="flex flex-col items-center text-center">
      <!-- Logo and Name -->
      <div class={`w-12 h-12 rounded-full bg-blue-300 mb-4`}></div>
      <h3 class="text-lg font-semibold mb-2">{game.name}</h3>
      <!-- Description -->
      <p class="text-sm text-gray-600 mb-2">{game.recommendation}</p>
    </div>

</div>
